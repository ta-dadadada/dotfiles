#!/bin/sh
# mise-global-hash={{ include "scripts/mise-global.sh" | sha256sum }}
# mise-local-hash={{ $local := joinPath .chezmoi.homeDir ".config/mise/config.local.toml" }}{{ if stat $local }}{{ output "cat" $local | sha256sum }}{{ else }}absent{{ end }}
# mise-config-hash={{ include "dot_config/mise/config.toml" | sha256sum }}
# ca-script-hash={{ include "run_onchange_after_15-build-ca-bundle.sh.tmpl" | sha256sum }}
set -eu
# 初回のCA生成時にはJDKがまだない場合があるため、miseの導入後に再確認する。
script=$(mktemp)
trap 'rm -f "$script"' EXIT HUP INT TERM
chezmoi --source {{ .chezmoi.sourceDir | quote }} execute-template -f {{ joinPath .chezmoi.sourceDir "run_onchange_after_15-build-ca-bundle.sh.tmpl" | quote }} > "$script"
sh "$script"
