# フォント設定
font-family = "DejaVu Sans Mono"
font-size = 13

# 行間の調整
adjust-cell-height = 10%

# 背景の透過とブラー
background-opacity = 0.95
background-blur = true

{{- if eq .chezmoi.os "darwin" }}
# ランダム背景画像
background-image = "{{ joinPath .chezmoi.homeDir ".config/ghostty/current_bg" }}"
background-image-fit = cover
background-image-opacity = 0.1
{{- end }}

# カーソル設定
cursor-style = block
cursor-style-blink = false

# 【重要】JISキーボードの円マークキーをバックスラッシュとして扱う
keybind = ¥=text:\\

# macOS特有の設定
macos-option-as-alt = true
window-decoration = true

# --- ローカル設定の読み込み ---
# ファイルが存在する場合のみ読み込む（エラー回避）
{{- $localConf := joinPath .chezmoi.homeDir ".config/ghostty/local.config" }}
{{- if stat $localConf }}
config-file = "local.config"
{{- end }}
