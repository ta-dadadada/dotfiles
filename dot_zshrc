# /etc/zshrcが.zshenvの後に追加した旧NixのPATHも除く。
if [[ -r "$HOME/.zshenv.d/nix.zsh" ]]; then
  source "$HOME/.zshenv.d/nix.zsh"
fi
if [[ -z "${JAVA_HOME:-}" && -r "$HOME/.zshenv.d/runtime.zsh" ]]; then
  source "$HOME/.zshenv.d/runtime.zsh"
fi

# Enable completion system
autoload -Uz compinit && compinit -u

# Load interactive shell configurations
if [[ -d "$HOME/.zshrc.d" ]]; then
  for file in "$HOME/.zshrc.d"/*.zsh; do
    if [[ -r "$file" ]]; then
      source "$file" || echo "Warning: Failed to load $file" >&2
    fi
  done
  unset file
fi


[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh


if [[ -f "$HOME/.zshrc.local" ]]; then
    source "$HOME/.zshrc.local"
fi
